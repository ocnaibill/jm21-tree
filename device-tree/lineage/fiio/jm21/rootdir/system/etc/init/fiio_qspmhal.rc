# Workaround: o qspmhal do vendor stock roda com filtro seccomp que bloqueia
# nanosleep; o libadreno_app_profiles.so recebe DEAD_OBJECT no meio da transacao
# HIDL e aborta o surfaceflinger, que reinicia o zygote/system_server em loop.
# O nome do servico em /vendor/etc/init/vendor.qti.qspmhal@1.0-service.rc e "qspmhal".
on late-init
    stop qspmhal

on property:init.svc.qspmhal=running
    stop qspmhal

