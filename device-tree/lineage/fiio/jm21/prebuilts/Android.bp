// Gerado a partir de dumps/fw-1.1.1 (system/app e system_ext/priv-app).
// Assinatura: certificate "platform" (o Soong assina com a chave da ROM).
// ATENCAO: re-assinar muda o certificado; todos os apps FiiO precisam sair
// juntos para continuarem se reconhecendo (ver prebuilts/README.md).

android_app_import {
    name: "AboutFiio",
    apk: "files/app/AboutFiio.apk",
    certificate: "platform",
    privileged: false,
    dex_preopt: {
        enabled: true,
    },
}


