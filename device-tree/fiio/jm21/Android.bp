// ---------------------------------------------------------------------------
// Lacunas do upstream do TWRP (forks mais antigos que o AOSP 12.1).
//
// O manifest do TWRP troca alguns projetos pelos forks do LineageOS/TeamWin
// (ex.: hardware/interfaces do LineageOS 19.1). O AOSP 12.1 retido referencia
// módulos que esses forks NAO tem, e o soong quebra no parse mesmo sem buildar
// esses módulos (sao testes/HAL que nao vao para a imagem de recovery).
//
// Cada stub abaixo e uma dessas lacunas. Sao vazios de proposito: existem so
// para o parse resolver. Nao ha desabilitacao de modulos nem edicao de arvore.
// ---------------------------------------------------------------------------

// hardware/interfaces (fork LineageOS 19.1): falta o default usado pelos
// neuralnetworks_utils_hal_*.
cc_defaults {
    name: "neuralnetworks_utils_defaults",
}

// Lacuna upstream: referenciado por android_test.
java_defaults {
    name: "libnetworkstackutilsjni_deps",
}

// Lacuna upstream: referenciado por java_test_host (stub so para o parse).
java_library_host {
    name: "compatibility-host-util",
}

// Lacuna upstream: referenciado por java_test_host (stub so para o parse).
java_library_host {
    name: "tradefed",
}

// Lacuna upstream: referenciado por java_test_host (stub so para o parse).
java_library_host {
    name: "platform-test-annotations-host",
}

// Lacuna upstream: referenciado por java_library_host (stub so para o parse).
java_library_host {
    name: "compatibility-tradefed",
}

// Lacuna upstream: referenciado por tradefed_binary_host (stub so para o parse).
java_library_host {
    name: "tradefed-test-framework",
}

// Lacuna upstream: referenciado por tradefed_binary_host (stub so para o parse).
java_library_host {
    name: "loganalysis",
}

// Lacuna upstream: referenciado por java_library_host (stub so para o parse).
java_library_host {
    name: "easymock",
}

// Lacuna upstream: referenciado por java_library_host (stub so para o parse).
java_library_host {
    name: "CtsDeqpRunnerTests",
}

// Lacuna upstream: referenciado por python_test_host (stub so para o parse).
cc_library {
    name: "vts_vndk_utils",
}

// Lacuna upstream: referenciado por java_library_static (stub so para o parse).
java_library_host {
    name: "objenesis",
}

// Lacuna upstream: referenciado por java_library (stub so para o parse).
java_library_host {
    name: "jcommander",
}

// Lacuna upstream: referenciado por java_library (stub so para o parse).
java_library_host {
    name: "snakeyaml",
}

// Lacuna upstream: referenciado por java_library (stub so para o parse).
java_library_host {
    name: "guice",
}
